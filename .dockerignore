# Control de versiones
.git
.gitignore
.gitattributes

# Dependencias (se instalan en la imagen)
vendor/
node_modules/

# Base de datos local (se crea en el contenedor)
database/*.sqlite
database/*.sqlite-wal
database/*.sqlite-shm

# Logs y caché locales
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Entorno local (se inyecta desde Easypanel)
.env
.env.backup
.env.production

# Archivos de desarrollo
*.md
Makefile
docker-compose*.yml
.editorconfig
.phpunit*
phpunit.xml
